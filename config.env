#!/usr/bin/env bash
#
# config.env
# ------------------------------------------------------------------
# Single source of truth for this cluster's topology and versions.
# Edit this file, then copy it (identical) to EVERY node — master,
# every worker, and the NFS node — before running any script.
#
# This file is sourced by the scripts, not executed directly.
# ------------------------------------------------------------------

# ---- Kubernetes / component versions ----------------------------
# Exact kubeadm/kubelet/kubectl version to install and pin.
K8S_VERSION="1.35.0"

# Pod network CIDR. 10.244.0.0/16 is Flannel's default — change it
# only if you know you need a different range (e.g. it collides with
# your LAN or VPN).
POD_CIDR="10.244.0.0/16"

# ---- Cluster topology --------------------------------------------
MASTER_HOSTNAME="master01"
MASTER_IP="172.17.0.232"

# Parallel arrays — index N in WORKER_HOSTNAMES must match index N
# in WORKER_IPS. Add/remove pairs to resize the cluster.
WORKER_HOSTNAMES=("worker01")
WORKER_IPS=("172.17.0.233")
# ---- NFS storage node ---------------------------------------------
NFS_HOSTNAME="nfs"
NFS_IP="172.17.0.2"
NFS_EXPORT_PATH="/srv/nfs/kubedata"

# ---- Derived values (do not edit) ---------------------------------
# CRI-O tracks Kubernetes minor versions (e.g. "1.35"), not patch
# versions, so this is computed automatically from K8S_VERSION.
K8S_MINOR="${K8S_VERSION%.*}"
CRIO_VERSION="v${K8S_MINOR}"
